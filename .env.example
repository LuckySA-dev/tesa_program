# =============================================================================
# TESA Defence AI - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your system.
# All values below are optional – sensible defaults are used if unset.

# --------------------------------------------------------------------------
# Device / Hardware
# --------------------------------------------------------------------------
# Force CPU even if CUDA is available (set to 1 to disable GPU)
# FORCE_CPU=0

# --------------------------------------------------------------------------
# Problem 1 – Detection
# --------------------------------------------------------------------------
# P1_MODEL_PATH=runs/detect/drone_detect_v21_max_data/weights/best.pt
# P1_CONF_THRESHOLD=0.10

# --------------------------------------------------------------------------
# Problem 2 – Localization
# --------------------------------------------------------------------------
# P2_MODEL_TYPE=xgboost
# P2_VIDEO_WIDTH=1920
# P2_VIDEO_HEIGHT=1080

# --------------------------------------------------------------------------
# Problem 3 – Full Pipeline
# --------------------------------------------------------------------------
# P3_VIDEO_PATH=videos/P3_VIDEO.mp4
# P3_OUTPUT_PATH=outputs/problem_3/final/P3_OUTPUT_FINAL.mp4
# P3_MODEL_PATH=runs/detect/drone_detect_v21_max_data/weights/best.pt
# P3_CONF_THRESHOLD=0.10
# P3_IOU_THRESHOLD=0.3

# --------------------------------------------------------------------------
# Streamlit Dashboard
# --------------------------------------------------------------------------
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# --------------------------------------------------------------------------
# API / Satellite Communication
# --------------------------------------------------------------------------
# API_PROTOCOL=rest            # rest | mqtt | websocket | grpc | mock
# API_URL=https://api.tesa.or.th/drone
# API_KEY=
# API_TIMEOUT=10               # seconds
# API_RETRIES=2                # automatic retry count

# MQTT-specific (only used when API_PROTOCOL=mqtt)
# MQTT_TOPIC=tesa/drone
# MQTT_QOS=1                   # 0, 1, or 2
